{
 "$description": "Paxton design system, product and site layer. Source of truth; tokens.css is generated from this file by build-tokens.mjs. Values follow visual system v5 (neutral r=g=b). $extensions.dark holds the dark-theme value.",
 "color": {
  "canvas": {
   "$type": "color",
   "$value": "#F3F3F3",
   "$extensions": {
    "dark": "#0A0A0B"
   },
   "$description": "Ground: page background, tool stage"
  },
  "stage": {
   "$type": "color",
   "$value": "#F8F8F8",
   "$extensions": {
    "dark": "#0F0F10"
   },
   "$description": "Container that holds raised items (portfolio stage, figure stage)"
  },
  "face": {
   "$type": "color",
   "$value": "#FAFAFA",
   "$extensions": {
    "dark": "#141416"
   },
   "$description": "Face: panels, sidebars, settings sheets"
  },
  "raised": {
   "$type": "color",
   "$value": "#FFFFFF",
   "$extensions": {
    "dark": "#1C1C1E"
   },
   "$description": "Raised: standalone buttons, cards, menus"
  },
  "track": {
   "$type": "color",
   "$value": "#ECECEC",
   "$extensions": {
    "dark": "#1C1C1E"
   },
   "$description": "Wells: segmented track (no edge), select and input (with 1px line-control edge). Text on tracks is text-1"
  },
  "selected": {
   "$type": "color",
   "$value": "#FFFFFF",
   "$extensions": {
    "dark": "#333336"
   },
   "$description": "轨道上的选中块（分段滑块）"
  },
  "selected-row": {
   "$type": "color",
   "$value": "#E0E0E0",
   "$extensions": {
    "dark": "#333336"
   },
   "$description": "面和浮层上的选中行、菜单选中项"
  },
  "placeholder": {
   "$type": "color",
   "$value": "#E4E4E4",
   "$extensions": {
    "dark": "#202022"
   },
   "$description": "Image and media placeholders"
  },
  "mass": {
   "$type": "color",
   "$value": "#D2D2D2",
   "$extensions": {
    "dark": "#3A3A3C"
   },
   "$description": "Large neutral fills; never ink"
  },
  "line": {
   "$type": "color",
   "$value": "rgba(0,0,0,.055)",
   "$extensions": {
    "dark": "rgba(255,255,255,.08)"
   },
   "$description": "1px hairline on faces and frames"
  },
  "line-control": {
   "$type": "color",
   "$value": "rgba(0,0,0,.07)",
   "$extensions": {
    "dark": "rgba(255,255,255,.09)"
   },
   "$description": "1px edge on raised items, thumbs, inputs"
  },
  "line-selected": {
   "$type": "color",
   "$value": "rgba(0,0,0,.07)",
   "$extensions": {
    "dark": "rgba(255,255,255,0)"
   },
   "$description": "Edge of a selected block: needed in light (1.18:1 fill difference), transparent in dark (1.35:1 is enough)"
  },
  "line-strong": {
   "$type": "color",
   "$value": "rgba(0,0,0,.12)",
   "$extensions": {
    "dark": "rgba(255,255,255,.14)"
   },
   "$description": "Dashed slots, hover-free emphasis of boundaries"
  },
  "text-1": {
   "$type": "color",
   "$value": "#1D1D1F",
   "$extensions": {
    "dark": "#EDEDEF"
   },
   "$description": "Primary text, values, selected labels, focus ring"
  },
  "text-2": {
   "$type": "color",
   "$value": "#6E6E6E",
   "$extensions": {
    "dark": "#A0A0A4"
   },
   "$description": "Secondary text, labels, group titles (>=4.5:1 on face)"
  },
  "text-3": {
   "$type": "color",
   "$value": "#8C8C8C",
   "$extensions": {
    "dark": "#7A7A7E"
   },
   "$description": "Tertiary: disabled, placeholder, decorative meta only (below 4.5:1)"
  },
  "ink": {
   "$type": "color",
   "$value": "#1D1D1F",
   "$extensions": {
    "dark": "#EDEDEF"
   },
   "$description": "1.5px emphasis stroke"
  },
  "accent": {
   "$type": "color",
   "$value": "#1471D6",
   "$extensions": {
    "dark": "#1471D6"
   },
   "$description": "The single accent: current, on, progress. Switch on, active icon, tab underline, checkbox and radio checked, slider fill. Never a large fill or text"
  },
  "accent-fill": {
   "$type": "color",
   "$value": "#1471D6",
   "$extensions": {
    "dark": "#1471D6"
   },
   "$description": "Primary action fill only (one per screen). White text 4.81:1"
  },
  "on-accent": {
   "$type": "color",
   "$value": "#FFFFFF",
   "$extensions": {
    "dark": "#FFFFFF"
   },
   "$description": "Knob and glyph on accent"
  },
  "switch-off": {
   "$type": "color",
   "$value": "#8C8C8C",
   "$extensions": {
    "dark": "#6E6E72"
   },
   "$description": "Switch track when off (>=3:1 against face)"
  },
  "danger": {
   "$type": "color",
   "$value": "#C62828",
   "$extensions": {
    "dark": "#FF6B60"
   },
   "$description": "Error text and indicator only; always paired with text or icon"
  },
  "scrim": {
   "$type": "color",
   "$value": "rgba(0,0,0,.32)",
   "$extensions": {
    "dark": "rgba(0,0,0,.6)"
   },
   "$description": "Behind dialogs"
  }
 },
